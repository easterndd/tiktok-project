NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Generate with: openssl rand -hex 32
POSTGRES_DB=quickreels
POSTGRES_USER=quickreels
POSTGRES_PASSWORD=<replace-with-a-long-hex-password>
DATABASE_URL=postgresql://quickreels:<same-long-hex-password>@postgres:5432/quickreels?schema=public

# Generate with: openssl rand -hex 32
JWT_SECRET=<replace-with-a-different-long-hex-secret>
API_CORS_ORIGIN=https://admin.evergreenprosper.com
TRUST_GEO_COUNTRY_HEADER=false
VITE_API_BASE_URL=https://api.evergreenprosper.com/api/v1

TIKTOK_CLIENT_KEY=<portal-client-key>
TIKTOK_CLIENT_SECRET=<portal-client-secret>
TIKTOK_OAUTH_TOKEN_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_USER_INFO_URL=https://open.tiktokapis.com/v2/user/info/?fields=open_id
USER_JWT_EXPIRES_IN=3600
ADMIN_JWT_EXPIRES_IN=28800
# Temporarily set both values only to create the first production administrator.
# Delete ADMIN_BOOTSTRAP_PASSWORD after `admin:bootstrap` succeeds.
# ADMIN_BOOTSTRAP_EMAIL=operator@example.com
# ADMIN_BOOTSTRAP_PASSWORD=<at-least-12-characters>

# These identifiers remain required by the current API configuration.
BYTEPLUS_ACCOUNT_ID=<byteplus-account-id>
BYTEPLUS_SPACE_NAME=<byteplus-space-name>
BYTEPLUS_REGION=ap-southeast-1
# BYTEPLUS_ACCESS_KEY=<backend-only-access-key>
# BYTEPLUS_SECRET_KEY=<backend-only-secret-key>
BYTEPLUS_VOD_ENDPOINT=https://vod.byteplusapi.com
UPLOAD_WORKER_INTERVAL_MS=30000
UPLOAD_MAX_RETRIES=5
