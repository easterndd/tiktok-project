NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Generate with: openssl rand -hex 32
POSTGRES_DB=quickreels
POSTGRES_USER=quickreels
POSTGRES_PASSWORD=<replace-with-a-long-hex-password>
DATABASE_URL=postgresql://quickreels:<same-long-hex-password>@postgres:5432/quickreels?schema=public

# Generate with: openssl rand -hex 32
JWT_SECRET=<replace-with-a-different-long-hex-secret>
ENTRY_AD_ATTRIBUTION_GATE_ENABLED=false
PERSIST_CLIENT_AD_DIAGNOSTICS=false
USER_DATA_ENCRYPTION_KEY=<different-random-secret-for-tiktok-credentials>
# Comma-separated allowlist. The TikTok and Mini runtime wildcards accept HTTPS subdomains only.
API_CORS_ORIGIN=https://admin.evergreenprosper.com,https://tiktok.com,https://*.tiktok.com,https://*.tiktokminis.us,https://*.tiktok-minis.us
# Set to Caddy's IP on quickreels-proxy, followed by /32. Recheck after recreating Caddy.
# TRUSTED_PROXY_CIDRS=172.20.0.2/32
TRUST_GEO_COUNTRY_HEADER=false
VITE_API_BASE_URL=https://api.evergreenprosper.com/api/v1
# Optional second mini app admin API and browser-side ad defaults.
# VITE_TALETV_API_BASE_URL=https://api.evergreenprosper.com/api/taletv/v1
# VITE_CINEREELS_API_BASE_URL=https://api.evergreenprosper.com/api/cinereels/v1
# VITE_TALEREELS_API_BASE_URL=https://api.evergreenprosper.com/api/talereels/v1
VITE_REWARDED_PLACEMENT_ID=ad7686459794040702993
VITE_TALETV_REWARDED_PLACEMENT_ID=ad7688599028879722512
VITE_APP_ENTRY_PLACEMENT_ID=ad7686459458972829697
# VITE_TALETV_APP_ENTRY_PLACEMENT_ID=
# VITE_CINEREELS_REWARDED_PLACEMENT_ID=
# VITE_CINEREELS_APP_ENTRY_PLACEMENT_ID=
# VITE_TALEREELS_REWARDED_PLACEMENT_ID=
# VITE_TALEREELS_APP_ENTRY_PLACEMENT_ID=

USER_JWT_EXPIRES_IN=3600
ADMIN_JWT_EXPIRES_IN=28800
# Temporarily set both values only to create the first production administrator.
# Delete ADMIN_BOOTSTRAP_PASSWORD after `admin:bootstrap` succeeds.
# ADMIN_BOOTSTRAP_EMAIL=operator@example.com
# ADMIN_BOOTSTRAP_PASSWORD=<at-least-12-characters>

# These identifiers remain required by the current API configuration.
BYTEPLUS_ACCOUNT_ID=<byteplus-account-id>
BYTEPLUS_SPACE_NAME=<byteplus-space-name>
BYTEPLUS_REGION=ap-southeast-1
# BYTEPLUS_ACCESS_KEY=<backend-only-access-key>
# BYTEPLUS_SECRET_KEY=<backend-only-secret-key>
BYTEPLUS_VOD_ENDPOINT=https://vod.byteplusapi.com
REWARDED_PLACEMENT_ID=ad7686459794040702993
TALETV_REWARDED_PLACEMENT_ID=ad7688599028879722512
APP_ENTRY_PLACEMENT_ID=ad7686459458972829697
# Optional episode-transition interstitial IDs. Leave blank until each app has its own Active placement.
EPISODE_INTERSTITIAL_PLACEMENT_ID=
# STORYLAND_EPISODE_INTERSTITIAL_PLACEMENT_ID=
# TALETV_APP_ENTRY_PLACEMENT_ID=
# CINEREELS_REWARDED_PLACEMENT_ID=<CineReels rewarded placement ID>
# CINEREELS_APP_ENTRY_PLACEMENT_ID=<CineReels entry placement ID, if enabled>
# TALEREELS_REWARDED_PLACEMENT_ID=<TaleReels rewarded placement ID>
# TALEREELS_APP_ENTRY_PLACEMENT_ID=<TaleReels entry placement ID, if enabled>
# CINEREELS_DATABASE_URL=postgresql://quickreels:<same-password>@postgres:5432/quickreels?schema=cinereels
# CINEREELS_TIKTOK_CLIENT_KEY=<CineReels Client Key>
# CINEREELS_TIKTOK_CLIENT_SECRET=<CineReels Client Secret>
# CINEREELS_TIKTOK_APP_ID=<CineReels App ID>
# TALEREELS_DATABASE_URL=postgresql://quickreels:<same-password>@postgres:5432/quickreels?schema=talereels
# TALEREELS_TIKTOK_CLIENT_KEY=<TaleReels Client Key>
# TALEREELS_TIKTOK_CLIENT_SECRET=<TaleReels Client Secret>
# TALEREELS_TIKTOK_APP_ID=<TaleReels App ID>
API_PUBLIC_BASE_URL=https://api.evergreenprosper.com
