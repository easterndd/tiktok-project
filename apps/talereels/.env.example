# Public values bundled into TaleReels. Never put Client Secret or BytePlus AK/SK here.
VITE_API_BASE_URL=https://api.evergreenprosper.com/api/talereels/v1
# build:minis:release generates a unique VITE_MINI_RELEASE_ID for each ZIP.
VITE_TIKTOK_CLIENT_KEY=REPLACE_WITH_TALEREELS_CLIENT_KEY
VITE_DEMO_MODE=false
VITE_USE_MOCK_API=false
VITE_ENABLE_MOCK_FALLBACK=false
