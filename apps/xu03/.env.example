# Public values bundled into the xu03 Mini app. Never put Client Secret or BytePlus AK/SK here.
# The shared production API must serve /api/xu03/v1 before uploading a Preview build.
VITE_API_BASE_URL=https://api.evergreenprosper.com/api/xu03/v1
VITE_APP_KEY=xu03
VITE_APP_NAME=xu03

# Required: xu03's public Client Key from TikTok for Developers (not the original app's key).
VITE_TIKTOK_CLIENT_KEY=REPLACE_WITH_XU03_CLIENT_KEY

# Keep all three false when testing real API/content in TikTok Preview.
VITE_DEMO_MODE=false
VITE_USE_MOCK_API=false
VITE_ENABLE_MOCK_FALLBACK=false

# Optional: a public, silent teaser URL for the first home card.
# VITE_HOME_PREVIEW_URL=https://cdn.example.com/xu03-teaser.mp4
# Optional build label sent with anonymous sessions.
# VITE_APP_VERSION=1.0.0

# Rewarded-ad placement IDs are configured in the admin's drama access settings.
# Entry-ad placement ID is configured in the admin's entry-ad policy.
# App ID is configured separately in apps/xu03/minis.config.json.
