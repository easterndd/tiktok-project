NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=public
# Optional dedicated shared database. All API instances and the worker must use the same URL.
# Defaults to DATABASE_URL when omitted.
# SHARED_PLATFORM_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=public
# Optional second mini app in the same API process. Use another schema or database.
# TALETV_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=taletv
# QUARTZPLAY_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=quartzplay
# Optional standalone app for AUGUST LANE MEDIA LIMITED.
# BLOOMREEL_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=bloomreel
# QUILLSHORT_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=quillshort
# RIFTSAGA_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=riftsaga
# HALOFLICKS_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=haloflicks
# THREADTALE_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=threadtale
# FABLEVIBE_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=fablevibe
# WISPREEL_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=wispreel
# YALAREELS_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=yalareels
# AMBERPLAY_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=amberplay
# NIMBUSCLIP_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=nimbusclip
# RUNEREEL_DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=runereel
API_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Maximum requests allowed into database-backed handlers at once.
API_DB_CONCURRENCY=96
# Maximum concurrent database-backed requests per Mini App.
API_DB_CONCURRENCY_PER_APP=24
# Requests waiting for a slot before returning 503.
API_DB_QUEUE_LIMIT=512
# Requests waiting for a slot for one Mini App.
API_DB_QUEUE_LIMIT_PER_APP=128
# Reserve critical capacity; expire queued work before database transaction acquisition.
API_DATABASE_CONNECTION_LIMIT=2
WORKER_DATABASE_CONNECTION_LIMIT=1
API_DB_RESERVED=24
API_DB_QUEUE_WAIT_MS=1000
# Read by the native database engine at startup, independently of DB connection counts.
TOKIO_WORKER_THREADS=2
# Keep false unless the reverse proxy overwrites X-Geo-Country with a trusted
# two-letter country code. Regional albums are safely hidden when it is absent.
TRUST_GEO_COUNTRY_HEADER=false
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ENTRY_AD_ATTRIBUTION_GATE_ENABLED=false
PERSIST_CLIENT_AD_DIAGNOSTICS=false
# Optional dedicated key for encrypting TikTok OAuth credentials at rest.
# USER_DATA_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
USER_JWT_EXPIRES_IN=3600
ADMIN_JWT_EXPIRES_IN=28800
# Optional first-admin bootstrap. The seed only creates this account when both values exist.
# ADMIN_BOOTSTRAP_EMAIL=operator@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-12-plus-characters
BYTEPLUS_ACCOUNT_ID=your_bound_byteplus_account_id
BYTEPLUS_SPACE_NAME=your_bound_vod_space_name
BYTEPLUS_REGION=ap-southeast-1
# Required when the API worker calls BytePlus VOD OpenAPI directly.
# Keep these values only in backend/runtime secrets; never expose them to Mini Web.
# BYTEPLUS_ACCESS_KEY=your_byteplus_access_key_id
# BYTEPLUS_SECRET_KEY=your_byteplus_secret_access_key
BYTEPLUS_VOD_ENDPOINT=https://vod.byteplusapi.com
# TikTok Short Drama Media Library OpenAPI. Keep these server-side only.
# TIKTOK_CLIENT_KEY=your_tiktok_client_key
# TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
# TALETV_TIKTOK_CLIENT_KEY=your_taletv_tiktok_client_key
# TALETV_TIKTOK_CLIENT_SECRET=your_taletv_tiktok_client_secret
# QUARTZPLAY_TIKTOK_CLIENT_KEY=your_quartzplay_tiktok_client_key
# QUARTZPLAY_TIKTOK_CLIENT_SECRET=your_quartzplay_tiktok_client_secret
# QUARTZPLAY_TIKTOK_APP_ID=your_quartzplay_tiktok_app_id
# BLOOMREEL_TIKTOK_CLIENT_KEY=your_bloomreel_tiktok_client_key
# BLOOMREEL_TIKTOK_CLIENT_SECRET=your_bloomreel_tiktok_client_secret
# BLOOMREEL_TIKTOK_APP_ID=your_bloomreel_tiktok_app_id
# QUILLSHORT_TIKTOK_CLIENT_KEY=your_quillshort_tiktok_client_key
# QUILLSHORT_TIKTOK_CLIENT_SECRET=your_quillshort_tiktok_client_secret
# QUILLSHORT_TIKTOK_APP_ID=your_quillshort_tiktok_app_id
# RIFTSAGA_TIKTOK_CLIENT_KEY=your_riftsaga_tiktok_client_key
# RIFTSAGA_TIKTOK_CLIENT_SECRET=your_riftsaga_tiktok_client_secret
# RIFTSAGA_TIKTOK_APP_ID=your_riftsaga_tiktok_app_id
# HALOFLICKS_TIKTOK_CLIENT_KEY=your_haloflicks_tiktok_client_key
# HALOFLICKS_TIKTOK_CLIENT_SECRET=your_haloflicks_tiktok_client_secret
# HALOFLICKS_TIKTOK_APP_ID=your_haloflicks_tiktok_app_id
# THREADTALE_TIKTOK_CLIENT_KEY=your_threadtale_tiktok_client_key
# THREADTALE_TIKTOK_CLIENT_SECRET=your_threadtale_tiktok_client_secret
# THREADTALE_TIKTOK_APP_ID=your_threadtale_tiktok_app_id
# FABLEVIBE_TIKTOK_CLIENT_KEY=your_fablevibe_tiktok_client_key
# FABLEVIBE_TIKTOK_CLIENT_SECRET=your_fablevibe_tiktok_client_secret
# FABLEVIBE_TIKTOK_APP_ID=your_fablevibe_tiktok_app_id
# WISPREEL_TIKTOK_CLIENT_KEY=your_wispreel_tiktok_client_key
# WISPREEL_TIKTOK_CLIENT_SECRET=your_wispreel_tiktok_client_secret
# WISPREEL_TIKTOK_APP_ID=your_wispreel_tiktok_app_id
# YALAREELS_TIKTOK_CLIENT_KEY=your_yalareels_tiktok_client_key
# YALAREELS_TIKTOK_CLIENT_SECRET=your_yalareels_tiktok_client_secret
# YALAREELS_TIKTOK_APP_ID=your_yalareels_tiktok_app_id
# AMBERPLAY_TIKTOK_CLIENT_KEY=your_amberplay_tiktok_client_key
# AMBERPLAY_TIKTOK_CLIENT_SECRET=your_amberplay_tiktok_client_secret
# AMBERPLAY_TIKTOK_APP_ID=your_amberplay_tiktok_app_id
# NIMBUSCLIP_TIKTOK_CLIENT_KEY=your_nimbusclip_tiktok_client_key
# NIMBUSCLIP_TIKTOK_CLIENT_SECRET=your_nimbusclip_tiktok_client_secret
# NIMBUSCLIP_TIKTOK_APP_ID=your_nimbusclip_tiktok_app_id
# RUNEREEL_TIKTOK_CLIENT_KEY=your_runereel_tiktok_client_key
# RUNEREEL_TIKTOK_CLIENT_SECRET=your_runereel_tiktok_client_secret
# RUNEREEL_TIKTOK_APP_ID=your_runereel_tiktok_app_id
# Rewarded episode-unlock ad placement IDs are independent per mini app.
REWARDED_PLACEMENT_ID=ad7686459794040702993
TALETV_REWARDED_PLACEMENT_ID=ad7688599028879722512
# App-entry ad placement IDs are also independent. Leave taletv empty until its
# entry/interstitial placement is created and confirmed.
APP_ENTRY_PLACEMENT_ID=ad7686459458972829697
# Optional per-app episode-transition interstitial; leave blank until an Active placement exists.
EPISODE_INTERSTITIAL_PLACEMENT_ID=
# Per-Mini episode-transition interstitials. Empty means this ad type stays disabled.
STORYFLICKS_EPISODE_INTERSTITIAL_PLACEMENT_ID=7698625673044428852
DRAMABLAZE_EPISODE_INTERSTITIAL_PLACEMENT_ID=ad7701250594312390677
CINEREELS_EPISODE_INTERSTITIAL_PLACEMENT_ID=ad7701598971906803713
DRAMAHIT_EPISODE_INTERSTITIAL_PLACEMENT_ID=ad7701591362000848902
TALETV_EPISODE_INTERSTITIAL_PLACEMENT_ID=ad7701229465732532245
# TALETV_APP_ENTRY_PLACEMENT_ID=
TIKTOK_SHORT_DRAMA_API_BASE=https://open.tiktokapis.com
API_PUBLIC_BASE_URL=http://localhost:3000
COVER_ASSET_STORAGE_DIR=tmp/cover-assets
# COVER_ASSET_PUBLIC_BASE_URL=https://cdn.example.com/covers
# Development only. Enables database records with localPlaybackUrl to use an HTML video fallback.
LOCAL_PLAYBACK_ENABLED=false
UPLOAD_WORKER_INTERVAL_MS=30000
UPLOAD_MAX_RETRIES=5
