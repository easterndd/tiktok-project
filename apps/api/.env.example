NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://quickreels:change-this-local-password@localhost:5432/quickreels?schema=public
API_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Keep false unless the reverse proxy overwrites X-Geo-Country with a trusted
# two-letter country code. Regional albums are safely hidden when it is absent.
TRUST_GEO_COUNTRY_HEADER=false
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=never-expose-this-value
TIKTOK_OAUTH_TOKEN_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_USER_INFO_URL=https://open.tiktokapis.com/v2/user/info/?fields=open_id
# Optional when the current TikTok login flow requires a redirect URI.
# TIKTOK_REDIRECT_URI=https://quickreels.example.com/auth/callback
USER_JWT_EXPIRES_IN=3600
ADMIN_JWT_EXPIRES_IN=28800
# Optional first-admin bootstrap. The seed only creates this account when both values exist.
# ADMIN_BOOTSTRAP_EMAIL=operator@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-12-plus-characters
BYTEPLUS_ACCOUNT_ID=your_bound_byteplus_account_id
BYTEPLUS_SPACE_NAME=your_bound_vod_space_name
BYTEPLUS_REGION=ap-southeast-1
# Required when the API worker calls BytePlus VOD OpenAPI directly.
# Keep these values only in backend/runtime secrets; never expose them to Mini Web.
# BYTEPLUS_ACCESS_KEY=your_byteplus_access_key_id
# BYTEPLUS_SECRET_KEY=your_byteplus_secret_access_key
BYTEPLUS_VOD_ENDPOINT=https://vod.byteplusapi.com
UPLOAD_WORKER_INTERVAL_MS=30000
UPLOAD_MAX_RETRIES=5
