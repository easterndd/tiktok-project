NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Use a Tencent Cloud managed PostgreSQL private endpoint in production.
DATABASE_URL=postgresql://<app_user>:<password>@<private-db-host>:5432/quickreels?schema=public
JWT_SECRET=<random-secret-at-least-32-characters>
# Comma-separated allowlist. The TikTok and Mini runtime wildcards accept HTTPS subdomains only.
API_CORS_ORIGIN=https://admin.evergreenprosper.com,https://tiktok.com,https://*.tiktok.com,https://*.tiktok-minis.us
TRUST_GEO_COUNTRY_HEADER=false

# Required at Compose build time for the admin web image. This is public browser-side configuration.
VITE_API_BASE_URL=https://api.evergreenprosper.com/api/v1
# Optional second mini app admin API and browser-side ad defaults.
# VITE_TALETV_API_BASE_URL=https://api.evergreenprosper.com/api/taletv/v1
VITE_REWARDED_PLACEMENT_ID=ad7686459794040702993
VITE_TALETV_REWARDED_PLACEMENT_ID=ad7688599028879722512
VITE_APP_ENTRY_PLACEMENT_ID=ad7686459458972829697
# VITE_TALETV_APP_ENTRY_PLACEMENT_ID=

USER_JWT_EXPIRES_IN=3600
ADMIN_JWT_EXPIRES_IN=28800

# Required when the BytePlus provider is enabled.
BYTEPLUS_ACCOUNT_ID=<byteplus-account-id>
BYTEPLUS_SPACE_NAME=<byteplus-space-name>
BYTEPLUS_REGION=ap-southeast-1
# BYTEPLUS_ACCESS_KEY=<backend-only-access-key>
# BYTEPLUS_SECRET_KEY=<backend-only-secret-key>
BYTEPLUS_VOD_ENDPOINT=https://vod.byteplusapi.com
REWARDED_PLACEMENT_ID=ad7686459794040702993
TALETV_REWARDED_PLACEMENT_ID=ad7688599028879722512
APP_ENTRY_PLACEMENT_ID=ad7686459458972829697
# TALETV_APP_ENTRY_PLACEMENT_ID=
API_PUBLIC_BASE_URL=https://api.evergreenprosper.com
COVER_ASSET_STORAGE_DIR=/var/lib/quickreels/cover-assets
# Use your CDN/object-storage public prefix in production when available.
# COVER_ASSET_PUBLIC_BASE_URL=https://cdn.evergreenprosper.com/covers
UPLOAD_WORKER_INTERVAL_MS=30000
UPLOAD_MAX_RETRIES=5
