{
  "name": "quickreels",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:mini": "pnpm --filter mini-web dev",
    "dev:taletv": "pnpm --filter taletv dev",
    "dev:api": "pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin-web dev",
    "dev:worker": "pnpm --filter api worker",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed"
  },
  "devDependencies": {
    "@tiktok-minis/cli": "1.2.0"
  }
}
